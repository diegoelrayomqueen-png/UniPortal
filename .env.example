# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" a Git.

# --- Entorno: development | test | production ---
ENVIRONMENT=development

# --- JWT ---
# Genera una clave con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Vida máxima absoluta de una sesión aunque se renueve (evita renovaciones infinitas)
SESSION_MAX_DAYS=30

# --- Base de datos SQLite ---
# Ruta relativa = relativa a la carpeta del proyecto (no al directorio desde donde ejecutes).
# En Render con disco persistente: sqlite:////var/data/uniportal.db
DATABASE_URL=sqlite:///./data/uniportal.db

# --- OTP ---
# El parcial exige 15 minutos de validez (máximo permitido; valores mayores se recortan a 15)
OTP_EXPIRE_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_CODES_PER_CHALLENGE=5

# --- Correo (SMTP) ---
# EMAIL_BACKEND=smtp envía correos reales; EMAIL_BACKEND=console solo imprime el OTP en la
# terminal y SOLO funciona fuera de producción. Si lo dejas vacío: smtp si hay SMTP_HOST, si no console.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
SMTP_FROM=UniPortal <tu_correo@gmail.com>
# starttls (587) | ssl (465) | none (solo desarrollo local)
SMTP_SECURITY=starttls

# --- CORS: orígenes separados por coma. Vacío = solo mismo origen (recomendado) ---
ALLOWED_ORIGINS=

# --- Otros ---
RATE_LIMIT_ENABLED=true
BCRYPT_ROUNDS=12
PORTAL_NAME=UniPortal
